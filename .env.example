# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# SQLite Database Path (use ':memory:' for ephemeral test runs)
DATABASE_PATH=./server/data/gramaglow.sqlite

# REQUIRED in production: HMAC-SHA256 signing secret (generate via: openssl rand -hex 32)
GRAMAGLOW_SECRET=change-this-to-a-32-byte-random-hex-secret

# Sarpanch Admin Credentials (SHA-256 hex digest of password)
ADMIN_USERNAME=sarpanch
ADMIN_PASSWORD_HASH=32e8797663799a0e4a677af273a75819edd8afb9e3016d53434d1112d158d799
